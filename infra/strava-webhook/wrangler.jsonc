// Keep workers.dev explicitly enabled: Strava's registered callback uses
// https://hall-se.per-e-hall.workers.dev/...
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hall-se",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-08-24",
  "workers_dev": true,
  "vars": {
    "GITHUB_REPOSITORY": "perehall/hall.se",
    "DISPATCH_EVENT_TYPE": "strava-activity-event",
    "GITHUB_API_VERSION": "2026-03-10",
    "DISPATCH_TIMEOUT_MS": "1500",
    "SUPABASE_PROJECT_URL": "https://izzevnhgtsvffpkccoai.supabase.co",
    "SUPABASE_TIMEOUT_MS": "2500",
    "TRAINING_INPUT_HOST": "xn--hll-qla.se"
  },
  "secrets": {
    "required": [
      "WEBHOOK_PATH_SECRET",
      "STRAVA_VERIFY_TOKEN",
      "STRAVA_OWNER_ID",
      "STRAVA_SUBSCRIPTION_ID",
      "GITHUB_DISPATCH_TOKEN",
      "SUPABASE_SECRET_KEY"
    ]
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "xn--hll-qla.se/tr%C3%A4ning/training-api/*",
      "zone_name": "xn--hll-qla.se"
    }
  ]
}
